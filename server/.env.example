NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echoask?schema=public
SESSION_COOKIE_NAME=echoask_session
SESSION_DAYS=14

# Optional: create a key in Google AI Studio. Keep it on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave MAIL_MODE=console for local development. Set smtp values to send email.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=EchoAsk <no-reply@example.com>

